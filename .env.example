# Porta do servidor
PORT=3000

# Senha do painel administrativo da escola
ADMIN_PASSWORD=troque-esta-senha

# Configuracao de e-mail (SMTP) - exemplo com Gmail/Google Workspace
# Para Gmail, gere uma "senha de app" em https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seuemail@escola.com.br
SMTP_PASS=sua-senha-de-app
EMAIL_FROM="Orientacao Vocacional <seuemail@escola.com.br>"

# URL publica onde o site sera acessado (usada para montar o link exclusivo do resultado)
BASE_URL=http://localhost:3000
